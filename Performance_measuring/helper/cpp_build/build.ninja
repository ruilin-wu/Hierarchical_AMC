ninja_required_version = 1.3
cxx = c++

cflags = -DTORCH_EXTENSION_NAME=latency_cpp_cpu_v2 -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/ruilin/miniconda3/envs/fpt_env/lib/python3.10/site-packages/torch/include -isystem /home/ruilin/miniconda3/envs/fpt_env/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/ruilin/miniconda3/envs/fpt_env/lib/python3.10/site-packages/torch/include/TH -isystem /home/ruilin/miniconda3/envs/fpt_env/lib/python3.10/site-packages/torch/include/THC -isystem /home/ruilin/miniconda3/envs/fpt_env/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3 -march=native -DNDEBUG
post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/ruilin/miniconda3/envs/fpt_env/lib/python3.10/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc



rule link
  command = $cxx $in $ldflags -o $out

build cpu_latency_kernels.o: compile /home/ruilin/SPL_Surreal/SPL_code/latency_comparison/helper/cpp/cpu_latency_kernels.cpp



build latency_cpp_cpu_v2.so: link cpu_latency_kernels.o

default latency_cpp_cpu_v2.so
